{
  "manifest_version": 3,
  "name": "OgeNotes — Save Link",
  "version": "0.1.0",
  "description": "Save the current browser tab to your OgeNotes Saved Links.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Save to OgeNotes",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost:3000/*"
  ]
}
