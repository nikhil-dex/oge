# Copy to .env.local for local development. Never commit real values.
MONGODB_URI=
MONGODB_DB=oge_notes

# Auth.js / Google OAuth (server-side only)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth App (login only; separate from future Oge Vault GitHub App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# Read-only Phase C inventory is an explicit operator-run command only.
# Do not set the acknowledgment globally for normal app startup.
# OGE_VAULT_INVENTORY_READ_ONLY=YES_COUNTS_ONLY npm run vault:inventory
# Supply an explicit MONGODB_DB; no deletion or migration is performed.
#
# Oge Vault (separate GitHub App, currently provisioning-only)
# HTTPS origin for production; http://localhost:3000 for local development
OGE_VAULT_BASE_URL=
OGE_VAULT_GITHUB_CLIENT_ID=
OGE_VAULT_GITHUB_CLIENT_SECRET=
OGE_VAULT_GITHUB_APP_ID=
# Base64-encoded PEM private key, server-side only; never expose it to browsers
OGE_VAULT_GITHUB_PRIVATE_KEY_BASE64=
# App slug for the Install GitHub App link on /vault
OGE_VAULT_GITHUB_APP_SLUG=
# Disabled by default. Isolated test API /api/vault/notes; does not change existing Notes.
OGE_VAULT_NOTE_API_PREVIEW=false
# Staging-only familiar Notes interface, backed by /api/vault/notes-main
OGE_VAULT_MAIN_PREVIEW=false
# B5.3b hybrid temporary drafts (requires MAIN_PREVIEW=true; staging only)
OGE_VAULT_HYBRID_DRAFT_PREVIEW=false
# Phase D3 single-note GitHub revision-history read/restore preview.
# Independent default-off flag; also requires MAIN_PREVIEW=true.
# Never enable before signed staging and unsynced-draft conflict tests pass.
OGE_VAULT_REVISION_PREVIEW=false
# D3b Notes-only GitHub snapshot download (NO import, drafts, revision
# history, Quick Notes or AirNotes). Default-off until isolated staging review.
OGE_VAULT_BACKUP_EXPORT_PREVIEW=false
# D3b2 read-only import conflict preview for Notes-only GitHub archives.
# This preview has NO import write endpoint or approval token.
# Use disposable, signed staging accounts only; never enable in production.
OGE_VAULT_BACKUP_IMPORT_PLAN_PREVIEW=false
# D3b2b2 also enables read-only /api/vault/backup-import/reconcile
# under this same flag. No automatic retry, draft cleanup or new writes.
# During an import, autosave is temporarily fenced; uncertain fences require
# manual operator recovery (no TTL). Live staging is still pending.
# D3b2b1 separate CREATE-ONLY approved import commit route (max 12 notes).
# Requires MAIN, NOTE_API and IMPORT_PLAN previews too. NEVER production.
# The request must contain an explicit confirmation, selected note UUIDs and
# the exact previously previewed target HEAD; stale/conflicting/drafted IDs
# are rejected after fresh checks. No import UI or live staging signoff yet.
OGE_VAULT_BACKUP_IMPORT_COMMIT_PREVIEW=false
# D3b2b2c2 / #46 READ-ONLY offline import-lock incident triage.
# Never configure these values as app startup defaults or commit actual IDs.
# Supply them only from an authorized operator's private secret manager.
# The script reads projected MongoDB metadata and verified GitHub HEAD.
# It NEVER deletes drafts, changes notes or releases a stale lock.
# OGE_VAULT_IMPORT_LOCK_INSPECT_READ_ONLY=YES_REDACTED_ONLY npm run vault:import-lock:inspect
# Required private env (intentionally no default values):
# OGE_VAULT_INSPECT_OWNER_ID, OGE_VAULT_INSPECT_SESSION_VERSION,
# OGE_VAULT_INSPECT_REPO_ID, OGE_VAULT_INSPECT_OPERATION_ID
# Also require explicit MONGODB_DB, MONGODB_URI and GitHub App credentials.
# See docs/OGE_VAULT_IMPORT_LOCK_OPERATOR_RUNBOOK.md before using.
# D3b2b2c3 / Milestone #47 LOCAL DISPOSABLE staging-only prewrite lock release.
# NEVER use on Atlas/remote/production data or an account with possible GitHub
# writes. The CLI hard-blocks all but localhost:27017 Mongo replica sets and
# database names starting oge_vault_recovery_staging_.
# Operators must independently verify their maintenance window and a second
# reviewer before supplying the required flags; they are attestations, NOT a
# cryptographic proof of human identity. All default UNSET.
# OGE_VAULT_PREWRITE_RELEASE_STAGING_ONLY=YES_DISPOSABLE_PREWRITE_ONLY
# OGE_VAULT_MAINTENANCE_QUIESCED=YES_ALL_WRITERS_STOPPED
# OGE_VAULT_INDEPENDENT_REVIEW=YES_SEPARATE_APPROVER
# OGE_VAULT_PREWRITE_RELEASE_CONFIRMATION=RELEASE_ONLY_PRE_GITHUB_WRITE_LOCK
# OGE_VAULT_RELEASE_STARTED_AT: exact 2026-...T...000Z from the lock
# OGE_VAULT_RELEASE_INCIDENT_ID: independently authorized incident UUID
# plus exact OGE_VAULT_INSPECT_* scope and explicit MONGODB_URI/MONGODB_DB.
# npm run vault:import-lock:release-prewrite-staging
# This is a narrow TRANSACTIONAL mutation of the metadata lock plus an audit
# record. GitHub-possible/legacy locks are never released by this command.
# D3b2b2c4a / Milestone #48 private metadata-only import-attempt evidence.
# Requires an explicit database, signed owner/session/repo/operation scope
# (OGE_VAULT_INSPECT_*), and a verified private GitHub App installation.
# No note blobs or drafts are read; neither imports nor locks are modified.
# OGE_VAULT_IMPORT_EVIDENCE_READ_ONLY=YES_METADATA_ONLY
# npm run vault:import-attempt:inspect
# Redacted candidate Git metadata is NOT full archive content verification,
# worker quiescence, automatic retry authorization or permission to unlock.
# Phase D staging-only legacy-storage fence. Default-off: never enable in
# production before signed GitHub Vault and hybrid-draft end-to-end signoff.
# When true, requires MAIN_PREVIEW and HYBRID_DRAFT_PREVIEW; it prevents
# connected Vault owners from using legacy MongoDB content APIs.
# It does NOT route or migrate data and deliberately returns 409/503 instead.
OGE_VAULT_CUTOVER_GUARD_PREVIEW=false
# B6 metadata-only GitHub index preview and explicit manual refresh.
# Default-off until live GitHub/MongoDB staging verification completes.
OGE_VAULT_FILE_INDEX_PREVIEW=false
# Independent AES-256-GCM key: exactly 64 hexadecimal characters, server-side only.
# Never rotate without a reviewed draft re-encryption/recovery procedure.
OGE_VAULT_DRAFT_KEY=

# Internal-only B5.3c GitHub deletion phase; MUST stay false/unset.
# No HTTP route calls the executor. Enabling this flag alone cannot authorize a job.
OGE_VAULT_DESTRUCTIVE_DELETE_INTERNAL=false
# Separate, internal-only post-GitHub metadata retirement gate. No public caller.
# Keeps the subject locked and its metadata intact; does not purge anything.
OGE_VAULT_SUBJECT_RETIRE_INTERNAL=false

# Optional provider keys; add only after the providers are selected and configured.
NEWS_API_KEY=
DICTIONARY_API_KEY=

# Required to encrypt user-provided Gemini API keys at rest (32+ characters; keep stable across deploys)
GEMINI_KEY_ENCRYPTION_SECRET=
