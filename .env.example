# Copy to .env.local for local development. Never commit real values.
MONGODB_URI=
MONGODB_DB=oge_notes

# Auth.js / Google OAuth (server-side only)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Set true only when running behind a trusted reverse proxy that sets forwarded host/protocol headers.
AUTH_TRUST_HOST=false

# Optional provider keys; add only after the providers are selected and configured.
NEWS_API_KEY=
DICTIONARY_API_KEY=
