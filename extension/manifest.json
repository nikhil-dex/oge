{
  "manifest_version": 3,
  "name": "OgeNotes — Study Toolbelt",
  "version": "0.2.0",
  "description": "Floating Quick Notes, Save URL and My Links toolbelt on websites, plus the extension popup.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "OgeNotes Study Toolbelt",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
