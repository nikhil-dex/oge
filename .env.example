# Copy to .env.local for local development. Never commit real values.
MONGODB_URI=
MONGODB_DB=oge_notes

# Auth.js / Google OAuth (server-side only)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Optional provider keys; add only after the providers are selected and configured.
NEWS_API_KEY=
DICTIONARY_API_KEY=

# Required to encrypt user-provided Gemini API keys at rest (32+ characters; keep stable across deploys)
GEMINI_KEY_ENCRYPTION_SECRET=
