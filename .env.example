# Copy to .env.local for local development. Never commit real values.
MONGODB_URI=
MONGODB_DB=oge_notes

# Auth.js / Google OAuth (server-side only)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth App (login only; separate from future Oge Vault GitHub App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# Read-only Phase C inventory is an explicit operator-run command only.
# Do not set the acknowledgment globally for normal app startup.
# OGE_VAULT_INVENTORY_READ_ONLY=YES_COUNTS_ONLY npm run vault:inventory
# Supply an explicit MONGODB_DB; no deletion or migration is performed.
#
# Oge Vault (separate GitHub App, currently provisioning-only)
# HTTPS origin for production; http://localhost:3000 for local development
OGE_VAULT_BASE_URL=
OGE_VAULT_GITHUB_CLIENT_ID=
OGE_VAULT_GITHUB_CLIENT_SECRET=
OGE_VAULT_GITHUB_APP_ID=
# Base64-encoded PEM private key, server-side only; never expose it to browsers
OGE_VAULT_GITHUB_PRIVATE_KEY_BASE64=
# App slug for the Install GitHub App link on /vault
OGE_VAULT_GITHUB_APP_SLUG=
# Disabled by default. Isolated test API /api/vault/notes; does not change existing Notes.
OGE_VAULT_NOTE_API_PREVIEW=false
# Staging-only familiar Notes interface, backed by /api/vault/notes-main
OGE_VAULT_MAIN_PREVIEW=false
# B5.3b hybrid temporary drafts (requires MAIN_PREVIEW=true; staging only)
OGE_VAULT_HYBRID_DRAFT_PREVIEW=false
# Phase D3 single-note GitHub revision-history read/restore preview.
# Independent default-off flag; also requires MAIN_PREVIEW=true.
# Never enable before signed staging and unsynced-draft conflict tests pass.
OGE_VAULT_REVISION_PREVIEW=false
# D3b Notes-only GitHub snapshot download (NO import, drafts, revision
# history, Quick Notes or AirNotes). Default-off until isolated staging review.
OGE_VAULT_BACKUP_EXPORT_PREVIEW=false
# D3b2 read-only import conflict preview for Notes-only GitHub archives.
# This preview has NO import write endpoint or approval token.
# Use disposable, signed staging accounts only; never enable in production.
OGE_VAULT_BACKUP_IMPORT_PLAN_PREVIEW=false
# D3b2b2 also enables read-only /api/vault/backup-import/reconcile
# under this same flag. No automatic retry, draft cleanup or new writes.
# During an import, autosave is temporarily fenced; uncertain fences require
# manual operator recovery (no TTL). Live staging is still pending.
# D3b2b1 separate CREATE-ONLY approved import commit route (max 12 notes).
# Requires MAIN, NOTE_API and IMPORT_PLAN previews too. NEVER production.
# The request must contain an explicit confirmation, selected note UUIDs and
# the exact previously previewed target HEAD; stale/conflicting/drafted IDs
# are rejected after fresh checks. No import UI or live staging signoff yet.
OGE_VAULT_BACKUP_IMPORT_COMMIT_PREVIEW=false
# D3b2b2c2 / #46 READ-ONLY offline import-lock incident triage.
# Never configure these values as app startup defaults or commit actual IDs.
# Supply them only from an authorized operator's private secret manager.
# The script reads projected MongoDB metadata and verified GitHub HEAD.
# It NEVER deletes drafts, changes notes or releases a stale lock.
# OGE_VAULT_IMPORT_LOCK_INSPECT_READ_ONLY=YES_REDACTED_ONLY npm run vault:import-lock:inspect
# Required private env (intentionally no default values):
# OGE_VAULT_INSPECT_OWNER_ID, OGE_VAULT_INSPECT_SESSION_VERSION,
# OGE_VAULT_INSPECT_REPO_ID, OGE_VAULT_INSPECT_OPERATION_ID
# Also require explicit MONGODB_DB, MONGODB_URI and GitHub App credentials.
# See docs/OGE_VAULT_IMPORT_LOCK_OPERATOR_RUNBOOK.md before using.
# D3b2b2c3 / Milestone #47 LOCAL DISPOSABLE staging-only prewrite lock release.
# NEVER use on Atlas/remote/production data or an account with possible GitHub
# writes. The CLI hard-blocks all but localhost:27017 Mongo replica sets and
# database names starting oge_vault_recovery_staging_.
# Operators must independently verify their maintenance window and a second
# reviewer before supplying the required flags; they are attestations, NOT a
# cryptographic proof of human identity. All default UNSET.
# OGE_VAULT_PREWRITE_RELEASE_STAGING_ONLY=YES_DISPOSABLE_PREWRITE_ONLY
# OGE_VAULT_MAINTENANCE_QUIESCED=YES_ALL_WRITERS_STOPPED
# OGE_VAULT_INDEPENDENT_REVIEW=YES_SEPARATE_APPROVER
# OGE_VAULT_PREWRITE_RELEASE_CONFIRMATION=RELEASE_ONLY_PRE_GITHUB_WRITE_LOCK
# OGE_VAULT_RELEASE_STARTED_AT: exact 2026-...T...000Z from the lock
# OGE_VAULT_RELEASE_INCIDENT_ID: independently authorized incident UUID
# plus exact OGE_VAULT_INSPECT_* scope and explicit MONGODB_URI/MONGODB_DB.
# npm run vault:import-lock:release-prewrite-staging
# This is a narrow TRANSACTIONAL mutation of the metadata lock plus an audit
# record. GitHub-possible/legacy locks are never released by this command.
# D3b2b2c4a / Milestone #48 private metadata-only import-attempt evidence.
# Requires an explicit database, signed owner/session/repo/operation scope
# (OGE_VAULT_INSPECT_*), and a verified private GitHub App installation.
# No note blobs or drafts are read; neither imports nor locks are modified.
# OGE_VAULT_IMPORT_EVIDENCE_READ_ONLY=YES_METADATA_ONLY
# npm run vault:import-attempt:inspect
# Redacted candidate Git metadata is NOT full archive content verification,
# worker quiescence, automatic retry authorization or permission to unlock.
# D3b2b2c4b / Milestone #49 read-only private original archive proof.
# Operator must supply an exact signed owner/session/repo/operation scope,
# an explicit MongoDB database, verified GitHub App and a private local file
# containing the ORIGINAL four-field approved import request (not only backup).
# The file must be an owned regular non-symlink file with 0600 permissions.
# CLI rejects files over the 8MiB+4096 bound or changing during read.
# OGE_VAULT_IMPORT_ARCHIVE_PROOF_READ_ONLY=YES_EXACT_ARCHIVE_ONLY
# OGE_VAULT_IMPORT_APPROVAL_FILE=/absolute/private/approval.json
# npm run vault:import-archive:prove
# This reads GitHub immutable note content ONLY FOR VERIFICATION and never
# prints/commits it; no MongoDB note content, draft retirement or lock release.
# Historical proof ≠ current note state, worker quiescence or retry permission.
# D3b2b2c4d / Milestone #51 — synthetic-only import staging configuration.
# NEVER set import preview flags on production. In a separately isolated,
# disposable staging deployment only, run:
# npm run vault:import:staging-preflight
# Requires OGE_VAULT_MAIN_PREVIEW, OGE_VAULT_HYBRID_DRAFT_PREVIEW,
# OGE_VAULT_NOTE_API_PREVIEW, OGE_VAULT_BACKUP_IMPORT_PLAN_PREVIEW and
# OGE_VAULT_BACKUP_IMPORT_COMMIT_PREVIEW all true IN STAGING ONLY.
# Requires deliberate staging-only acknowledgment:
# OGE_VAULT_IMPORT_STAGING_ACK=ISOLATED_SYNTHETIC_ACCOUNTS_ONLY
# This is configuration-only, NO real OAuth/GitHub installation/two-device
# proof, provider requests, MongoDB writes or authorization to cut over.
# Milestone #53 — separate read-only chunked current-GitHub-Notes export.
# OFF by default; for an isolated staging deployment with disposable notes ONLY.
# Requires OGE_VAULT_MAIN_PREVIEW=true and OGE_VAULT_BACKUP_EXPORT_PREVIEW=true,
# plus OGE_VAULT_BACKUP_EXPORT_CHUNK_PREVIEW=true.
# GET /api/vault/backup-export/chunk (first page, without query parameters)
# GET /api/vault/backup-export/chunk?snapshot=<40-hex-sha>&after=<UUID>
# (follow exactly the snapshot and nextAfterId from preceding page).
# Maximum 64 notes / 4 MiB per response. Not a legacy-import/restore format.
# Verify ALL chunks of one immutable snapshot and SHA-256 inventory locally.
# GitHub branch must stay unchanged during export; stale cursor returns 409.
# No note plaintext is written to MongoDB. No production flag enabled here.
# M54 private read-only large-vault Notes chunk restore-conflict planning.
# This is NOT GitHub note restore, import approval, or authenticated source proof.
# Requires original OGE_VAULT_INSPECT_OWNER_ID, OGE_VAULT_INSPECT_SESSION_VERSION,
# OGE_VAULT_INSPECT_REPO_ID, explicit MONGODB_URI and MONGODB_DB, verified
# read-only GitHub App installation and PRIVATE LOCAL downloaded chunk files.
# OGE_VAULT_CHUNK_RESTORE_PLAN_READ_ONLY=YES_VERIFIED_NOTES_CHUNKS_ONLY
# OGE_VAULT_CHUNK_PLAN_DIRECTORY=/absolute/private/oge-notes-chunks
# mkdir -m 700 /absolute/private/oge-notes-chunks
# Put each part as part-0001.json, part-0002.json, ... with mode 0600.
# npm run vault:chunk:restore-plan
# Reads one at a time. GitHub Vault source chunk SHA-256 is not authenticated
# provenance. Preview returns at most 12 UUIDs and CANNOT commit GitHub notes.
# M55 independent signed GitHub current-source chunk verification (read-only).
# OFF by default. Requires the exact scoped owner/session/repo
# OGE_VAULT_INSPECT_* variables, MONGODB_DB/URI, GitHub App credentials and
# OGE_VAULT_CHUNK_PLAN_DIRECTORY pointing at owned 0700 private files
# named part-0001.json ... part-0016.json with 0600 regular file permissions.
# OGE_VAULT_CHUNK_SOURCE_PROOF_READ_ONLY=YES_CURRENT_GITHUB_HEAD_ONLY
# npm run vault:chunk:verify-source
# First checks EVERY chunk; then reads current source Git HEAD/tree, each
# real Git SHA-1 blob and full note content against the backup, no writes.
# Max 1024 current Notes / 16 parts. Old/erased HEAD cannot be proven here.
# Returns metadata-only, exit 2 on proof; NEVER allows restore/unlock/retry.
# M56 read-only historical source GitHub Notes chunk proof (not restore).
# EXCLUSIVE opt-in (leave OGE_VAULT_CHUNK_SOURCE_PROOF_READ_ONLY unset):
# OGE_VAULT_CHUNK_SOURCE_HISTORY_READ_ONLY=YES_20_LINEAR_ANCESTORS_ONLY
# npm run vault:chunk:verify-history
# Same signed owner/session/private GitHub repo and 0700 private directory
# with ordered 0600 part-*.json as M55 current-source proof.
# Only accepts source snapshots within 20 SINGLE-PARENT commits behind
# the verified private branch HEAD; merges/detached/deleted source fail.
# Verifies full historical Git tree and raw immutable Git SHA-1 blobs,
# not present-day note contents, never authorizes import/unlock/retry.
# M57 safe, selected CREATE-ONLY chunk batch-intent preparation (NO writes).
# Strictly read-only, exclusive with OGE_VAULT_CHUNK_RESTORE_PLAN_READ_ONLY.
# Requires signed owner/session/repo, MongoDB URI/DB, contents:read GitHub App,
# source Git history <= 20 linear commits and up to 1,024 source Notes/16 parts.
# OGE_VAULT_CHUNK_BATCH_INTENT_READ_ONLY=YES_EXACT_VERIFIED_SELECTION_ONLY
# OGE_VAULT_CHUNK_BATCH_SELECTION_FILE=/private/owner-selected-batch.json
# OGE_VAULT_CHUNK_PLAN_DIRECTORY=/private/oge-notes-chunks
# npm run vault:chunk:batch-intent
# Selection file must be owned regular 0600 non-symlink (<= 4 KiB), with
# EXACT JSON fields: confirmation (PREPARE_CREATE_ONLY_RESTORE_BATCH),
# expectedSourceSnapshot (40-hex SHA), expectedSourceInventorySha256 (64-hex),
# expectedTargetHead (40-hex SHA) and selectedIds (1..12 distinct UUIDs).
# Downloaded chunks remain contiguous private part-0001.json... in a 0700
# directory, each file 0600. All checked before DB/GitHub connections.
# A returned fingerprint/eligible result IS NOT a commit authorization;
# there is no new GitHub mutation, retry, recovery release, or draft deletion.
# Milestone #58 — actual single-batch GitHub restore EXECUTOR (NO exposed route).
# OFF by default. The module is internal and must not be wired to any
# production handler/cron/CLI without separate staged owner approval review.
# It requires BOTH independent env values below in addition to existing
# OGE_VAULT_MAIN_PREVIEW=true, OGE_VAULT_NOTE_API_PREVIEW=true,
# OGE_VAULT_BACKUP_IMPORT_PLAN_PREVIEW=true and
# OGE_VAULT_BACKUP_IMPORT_COMMIT_PREVIEW=true:
# OGE_VAULT_CHUNK_RESTORE_COMMIT_PREVIEW=true
# OGE_VAULT_CHUNK_RESTORE_WRITE_ACK=YES_DISPOSABLE_SIGNED_STAGING_ONLY
# NEVER enable these for production users. The source must be the SAME
# signed owner-connected private GitHub Vault, within 20 linear commits.
# Exact explicit COMMIT_VERIFIED_CHUNK_BATCH_CREATE_ONLY selection with an
# owner-reviewed M57 64-hex fingerprint, source inventory and target HEAD
# is required. Maximum 12 create-only Notes per GitHub CAS commit.
# Uncertain GitHub write outcomes retain the MongoDB owner quarantine;
# NEVER blindly retry or manually clear a github-write-possible lock.
# There is no user-facing endpoint, no full multi-batch resume and no
# production restore authorization in this milestone.
# M59 signed Auth.js -> one-time private-file staging restore bridge.
# OFF by default: keep this entirely separate from production.
# Deployed staging + operator command must BOTH use the SAME dedicated
# TLS/Atlas MongoDB database named oge_vault_restore_staging_* (not localhost).
# Existing isolated staging Auth.js/GitHub App/hybrid Notes/import flags
# and M58 OGE_VAULT_CHUNK_RESTORE_COMMIT_PREVIEW=true plus
# OGE_VAULT_CHUNK_RESTORE_WRITE_ACK=YES_DISPOSABLE_SIGNED_STAGING_ONLY
# are still required only on isolated synthetic staging accounts.
# OGE_VAULT_CHUNK_RESTORE_APPROVAL_PREVIEW=true
# OGE_VAULT_CHUNK_RESTORE_APPROVAL_KEY=<32-byte lowercase hex secret, private>
# POST /api/vault/backup-import/chunk/authorize from same-origin signed browser
# issues a 10-minute HMAC receipt (NO note-content upload, NO Git write).
# Protect returned receipt in a separate owner-only 0600 JSON file:
# OGE_VAULT_CHUNK_RESTORE_TICKET_FILE=/private/signed-ticket.json
# GET /api/vault/backup-import/chunk/status?receiptId=<64-hex-nonce-hash>
# returns owner-only pending/claimed/confirmed metadata, never unlock/retry.
# Separate operator CLI only: npm run vault:chunk:restore-staging
# OGE_VAULT_CHUNK_RESTORE_STAGING_OPERATOR=YES_ONE_SIGNED_BATCH_ONLY
# OGE_VAULT_CHUNK_RESTORE_STAGING_ACK=YES_SEPARATE_SYNTHETIC_STAGING_DATABASE
# OGE_VAULT_INSPECT_OWNER_ID=<exact signed staging account>
# OGE_VAULT_INSPECT_SESSION_VERSION=<exact signed session>
# OGE_VAULT_INSPECT_REPO_ID=<exact private GitHub Vault repository ID>
# OGE_VAULT_INSPECT_INSTALLATION_ID=<exact GitHub App installation ID>
# OGE_VAULT_CHUNK_PLAN_DIRECTORY=/private/oge-notes-chunks
# chunk directory 0700; contiguous part-0001.json ... 0600 (<=16 parts).
# One receipt MUST be atomically claimed once before GitHub writes; failed/
# uncertain commit outcomes are NEVER retried. Metadata TTL = 7 days after
# receipt expiry. NO automatic multi-batch resume or uncertain-lock release.
# Full procedure: docs/OGE_VAULT_SIGNED_RESTORE_STAGING.md
# M60 signed owner read-only progress across independently approved batches.
# Uses EXISTING default-OFF M59 staging gate:
# OGE_VAULT_CHUNK_RESTORE_APPROVAL_PREVIEW=true  (isolated staging ONLY)
# GET /api/vault/backup-import/chunk/history
# Requires same signed Auth.js session and dedicated secure staging MongoDB.
# Shows only latest 25 owner/repo/installation-scoped receipt metadata;
# no private note contents, no GitHub read/write token and no DB mutations.
# Claimed-but-unconfirmed receipts, import locks, malformed or truncated
# history all BLOCK progression/recovery. Even confirmed records do NOT
# verify current GitHub HEAD nor authorize auto-next/auto-retry/unlock.
# New restore approval also refuses claimed or owner-quarantined state.
# See docs/OGE_VAULT_SIGNED_RESTORE_STAGING.md
# M61 default-off, operator-only REAL GitHub App READ probe (no writes).
# This probe code is implemented but has NOT been run against actual
# dedicated staging GitHub credentials or two physical browsers/devices.
# A passing GET-only probe is NOT live restore acceptance or write approval.
# Requires existing isolated checkVaultStagingReadiness prerequisites,
# exact protected staging MongoDB (oge_vault_restore_staging_*),
# Auth.js-signed staging owner/session and a disposable private Vault.
# OGE_VAULT_REAL_PROVIDER_PROBE_READ_ONLY=YES_ISOLATED_PRIVATE_STAGING_GETS_ONLY
# OGE_VAULT_INSPECT_OWNER_ID=<signed-disposable-owner>
# OGE_VAULT_INSPECT_SESSION_VERSION=<signed-session-incarnation>
# OGE_VAULT_INSPECT_REPO_ID=<disposable-private-repository-id>
# OGE_VAULT_INSPECT_INSTALLATION_ID=<disposable-GitHub-App-installation-id>
# npm run vault:staging:provider-probe
# Internally requests two independently scoped contents:read clients,
# compares private repo HEAD / commit tree and owner mapping with GETs only.
# No OAuth browser tests, Git write token, note body read, or Mongo writes.
# No user notes, source chunk files or return of Git SHA/owner IDs.
# Full external acceptance checklist is still BLOCKED and unsigned:
# docs/OGE_VAULT_SIGNED_RESTORE_STAGING.md
# M62 signed owner restore review UI — NO NEW write toggle.
# /vault/restore-staging is 404 unless isolated M59 staging gates pass:
# OGE_VAULT_CHUNK_RESTORE_APPROVAL_PREVIEW=true (ONLY in staging)
# OGE_VAULT_MAIN_PREVIEW=true
# OGE_VAULT_HYBRID_DRAFT_PREVIEW=true
# OGE_VAULT_NOTE_API_PREVIEW=true
# OGE_VAULT_BACKUP_IMPORT_PLAN_PREVIEW=true
# OGE_VAULT_BACKUP_IMPORT_COMMIT_PREVIEW=true
# MONGODB_DB=oge_vault_restore_staging_<disposable>
# OGE_STAGING_URL / OGE_VAULT_BASE_URL / AUTH_URL matching protected HTTPS.
# The Auth.js account MUST own a connected private GitHub Vault.
# Browser review accepts SHA/UUID metadata only and issues a 10-minute
# one-use ticket, never uploads private Notes or invokes a GitHub write.
# The ticket lives in temporary browser memory until explicitly copied
# to an owner-only 0600 file for the separate signed staging operator.
# UI/status never authorizes automatic next batch/retry/lock release.
# Live two-device GitHub provider signoff is NOT complete.
# Docs: docs/OGE_VAULT_SIGNED_RESTORE_STAGING.md
# M63 browser-local private backup chunk verification for staging review.
# No additional env flag / network endpoint: it uses existing DEFAULT-OFF
# OGE_VAULT_CHUNK_RESTORE_APPROVAL_PREVIEW protected staging UI gate.
# On /vault/restore-staging, the owner must choose complete private
# part-0001.json... files (<=16 parts, <=4 MiB each, <=1024 Notes);
# Web Crypto SHA-256 checks complete ordered source inventory and the
# locally computed selected-note M57 fingerprint for the reviewed target.
# No Note titles/answers are returned, uploaded or persisted by the check.
# This is LOCAL integrity only: it does NOT prove authentic GitHub blobs,
# signed owner, draft conflicts or the current destination Git HEAD.
# The M58 signed operator independently re-checks GitHub raw blobs and
# owner/subject/draft fencing. An unknown receipt POST never replays
# within the same browser review session. All production flags remain OFF.
# See docs/OGE_VAULT_SIGNED_RESTORE_STAGING.md
# M64 isolated owner browser chunk backup DOWNLOAD (no new write permission).
# The hidden /vault/restore-staging UI adds a download button ONLY when BOTH
# pre-existing default-OFF read-only export flags are explicitly enabled:
# OGE_VAULT_BACKUP_EXPORT_PREVIEW=true
# OGE_VAULT_BACKUP_EXPORT_CHUNK_PREVIEW=true
# It ALSO requires all M59-M63 isolated staging/owner/approval gates.
# GET only; pinned current Git HEAD/nextAfterId, max 16 parts, 4 MiB each,
# max 1,024 current Notes. Each complete response is checksummed and offered
# as part-0001.json... via temporary browser Blob download.
# Browser multi-download permission may be blocked; verification of HTTP
# responses NEVER proves that every file was saved on disk.
# Check actual downloaded files using the M63 local File picker, and encrypt
# archived JSON files offline before retention. No GitHub/DB write, uploads,
# automatic retries, historical revisions, Quick Notes, AirNotes or drafts.
# Docs: docs/OGE_VAULT_SIGNED_RESTORE_STAGING.md
# M65 offline client-side ENCRYPTED Notes backup pages (no new flag).
# Existing default-OFF staging export+approval gates remain required.
# Downloaded pages now use part-0001.oge.json ... encrypted JSON files.
# Password (16+ chars, unique and high entropy) is never set in an env var,
# POSTed to a service, placed in browser local/session storage or logged.
# Web Crypto: PBKDF2-SHA-256 600000 iterations, AES-256-GCM, fresh salt
# per backup, random IV per part. LOST PASSWORD = NO RECOVERY.
# Browser local review decrypts encrypted files in ephemeral memory before
# the existing M63 Note/inventory/selected fingerprint checks.
# Existing M58/M59 OPERATOR RESTORE still needs plaintext 0600 files;
# encrypted-file operator conversion and source-GitHub-independent
# disaster recovery are NOT yet implemented. Do not bypass provenance.
# Docs: docs/OGE_VAULT_ENCRYPTED_OFFLINE_BACKUP.md
# Phase D staging-only legacy-storage fence. Default-off: never enable in
# production before signed GitHub Vault and hybrid-draft end-to-end signoff.
# When true, requires MAIN_PREVIEW and HYBRID_DRAFT_PREVIEW; it prevents
# connected Vault owners from using legacy MongoDB content APIs.
# It does NOT route or migrate data and deliberately returns 409/503 instead.
OGE_VAULT_CUTOVER_GUARD_PREVIEW=false
# B6 metadata-only GitHub index preview and explicit manual refresh.
# Default-off until live GitHub/MongoDB staging verification completes.
OGE_VAULT_FILE_INDEX_PREVIEW=false
# Independent AES-256-GCM key: exactly 64 hexadecimal characters, server-side only.
# Never rotate without a reviewed draft re-encryption/recovery procedure.
OGE_VAULT_DRAFT_KEY=

# Internal-only B5.3c GitHub deletion phase; MUST stay false/unset.
# No HTTP route calls the executor. Enabling this flag alone cannot authorize a job.
OGE_VAULT_DESTRUCTIVE_DELETE_INTERNAL=false
# Separate, internal-only post-GitHub metadata retirement gate. No public caller.
# Keeps the subject locked and its metadata intact; does not purge anything.
OGE_VAULT_SUBJECT_RETIRE_INTERNAL=false

# Optional provider keys; add only after the providers are selected and configured.
NEWS_API_KEY=
DICTIONARY_API_KEY=

# Required to encrypt user-provided Gemini API keys at rest (32+ characters; keep stable across deploys)
GEMINI_KEY_ENCRYPTION_SECRET=

# M66 encrypted-only operator intake, optional DEFAULT-OFF, staging only:
# OGE_VAULT_CHUNK_RESTORE_ENCRYPTED_OPERATOR=YES_PRIVATE_ENCRYPTED_PARTS_FD3_ONLY
# Chunk dir: owner-only 0700; complete part-NNNN.oge.json files 0600 only.
# Provide password via dedicated EOF-terminated FD3 pipe to node CLI directly;
# NEVER pass via argv, env, logs, stored password file or plaintext temp copy.
# See docs/OGE_VAULT_ENCRYPTED_OFFLINE_BACKUP.md

# M67 external two-device evidence INDEX review only — default OFF.
# No OAuth/GitHub/DB requests and NO physical device/signoff claims.
# OGE_VAULT_TWO_DEVICE_EVIDENCE_REVIEW=YES_REDACTED_EXTERNAL_EVIDENCE_ONLY
# OGE_VAULT_TWO_DEVICE_EVIDENCE_FILE=/private/owned-0700-dir/manifest-0600.json
# Requires isolated OGE_STAGING_URL HTTPS origin and
# MONGODB_DB=oge_vault_restore_staging_<disposable>, not production.
# npm run vault:staging:two-device-evidence
# Even exit=0 only means redacted index review-ready; NOT a release gate PASS.
# docs/OGE_VAULT_TWO_DEVICE_STAGING_ACCEPTANCE.md

# M68 optional OFFLINE on-disk external evidence SHA256 recheck (DEFAULT OFF).
# Does not verify provider truth, real devices, completeness of redaction or
# production signoff. It must use a private 0700 directory of 0600 files;
# keep this different from the private 0600 JSON manifest directory.
# OGE_VAULT_TWO_DEVICE_EVIDENCE_HASH_REVIEW=YES_PRIVATE_REDACTED_ARTIFACTS_READ_ONLY
# OGE_VAULT_TWO_DEVICE_ARTIFACT_DIRECTORY=/private/0700-artifacts
# Reuse OGE_VAULT_TWO_DEVICE_EVIDENCE_FILE and isolated HTTPS staging origin.
# npm run vault:staging:verify-evidence-files

# E1 / M69 owner-only subject Quick Capture pilot (DEFAULT OFF).
# This creates ordinary subject-linked GitHub Notes, NOT standalone
# Quick Notes/AirNotes/extension writes. Encrypted MongoDB drafts are temporary;
# the owner must explicitly press Save to commit to private GitHub.
# REQUIRES all existing protected staging Vault, Notes and hybrid-draft gates:
# OGE_VAULT_MAIN_PREVIEW=true
# OGE_VAULT_NOTE_API_PREVIEW=true
# OGE_VAULT_HYBRID_DRAFT_PREVIEW=true
OGE_VAULT_QUICK_CAPTURE_PREVIEW=false
# Also requires checkVaultStagingReadiness, OGE_STAGING_URL=AUTH_URL,
# MONGODB_DB=oge_vault_restore_staging_<disposable> and signed connected owner.
# Never enable in production; no OAuth/physical two-device signoff yet.
# docs/OGE_VAULT_QUICK_CAPTURE_E1.md

# E2/M70 independently stored standalone GitHub Quick Notes / AirNotes.
# New isolated API, NOT a migration and NOT part of normal Quick Notes pages.
# Default OFF. Gate for disposable protected staging only:
OGE_VAULT_STANDALONE_PREVIEW=false
# Requires existing OGE_VAULT_MAIN_PREVIEW, OGE_VAULT_NOTE_API_PREVIEW,
# OGE_VAULT_HYBRID_DRAFT_PREVIEW all true, signed connected GitHub Vault,
# and checkVaultStagingReadiness on oge_vault_restore_staging_<disposable>.
# GET /api/vault/standalone?kind=quick-notes|airnotes (read-only scoped token)
# POST/PUT/DELETE: explicit owner + one verified GitHub commit only.
# Standalone encrypted autosave/UI and complete backup remain FUTURE work.
# Never enable on production; no real GitHub two-device signoff yet.
# docs/OGE_VAULT_STANDALONE_STORAGE_E2.md

# E3 / M71 TEMPORARY encrypted standalone draft backend, default OFF.
# Requires E2 standalone GitHub preview + all other isolated Vault staging
# gates. Never put plaintext Note contents or this encryption key in Git.
# Exact owner/repo/kind/UUID/revision is protected by HKDF+AES-256-GCM AAD.
# No TTL; never silently discard unsaved drafts. UI wiring is FUTURE work.
OGE_VAULT_STANDALONE_DRAFT_PREVIEW=false
# GET/PUT/POST /api/vault/standalone-drafts (owner-signed, isolated staging)
# PUT autosaves AES-GCM ciphertext to vault_standalone_drafts ONLY.
# POST may only read GitHub and reconcile exact confirmed draft revision.
# Reuses OGE_VAULT_DRAFT_KEY, with domain-separated HKDF key.
# docs/OGE_VAULT_STANDALONE_ENCRYPTED_DRAFTS_E3.md

# E4/M72 optional browser Quick Notes/AirNotes hybrid preview (DEFAULT OFF).
# Requires ALL M70 and M71 stage APIs, an isolated signed HTTPS origin,
# exact AUTH_URL=OGE_STAGING_URL, disposable oge_vault_restore_staging_* DB,
# validated connected private Vault and checkVaultStagingReadiness=true.
OGE_VAULT_STANDALONE_EDITOR_PREVIEW=false
# /vault/standalone-editor is a staging-only browser pilot.
# Session storage keeps plaintext best-effort local recovery (browser-only);
# MongoDB has temporary AES-256-GCM drafts; confirmed content is GitHub ONLY.
# NO legacy page migration, extension write, auto GitHub Save, or bulk export.
# docs/OGE_VAULT_STANDALONE_EDITOR_E4.md

# E5/M73 current GitHub THREE-resource backup (DEFAULT OFF, staging ONLY).
# Exports complete CURRENT Notes + standalone Quick Notes + AirNotes at one
# verified GitHub HEAD. History, encrypted drafts, learning progress and
# legacy MongoDB notes are explicitly EXCLUDED; NOT a full account backup.
# Strict 8-MiB / 300-per-standalone-type limits fail CLOSED if exceeded.
OGE_VAULT_CURRENT_RESOURCE_BACKUP_PREVIEW=false
# Requires OGE_VAULT_BACKUP_EXPORT_PREVIEW, OGE_VAULT_STANDALONE_PREVIEW,
# OGE_VAULT_MAIN_PREVIEW, OGE_VAULT_NOTE_API_PREVIEW,
# OGE_VAULT_HYBRID_DRAFT_PREVIEW all true, full staging readiness,
# OGE_STAGING_URL=AUTH_URL, connected signed Vault owner/session and
# MONGODB_DB=oge_vault_restore_staging_<disposable>.
# GET /api/vault/backup-current-resources is read-only contents:read.
# JSON download includes PRIVATE plaintext committed content; store safely.
# No import/restore action accepts this new backup. PR #35 remains draft.
# docs/OGE_VAULT_CURRENT_RESOURCE_BACKUP_E5.md

# E6/M74 READ-ONLY advisory restore CONFLICT PLAN for M73 resource archive.
# DEFAULT OFF. Does NOT import, write GitHub, overwrite Notes or clear drafts.
# Expects application/json full M73 archive in memory (<=8 MiB).
OGE_VAULT_CURRENT_RESOURCE_RESTORE_PLAN_PREVIEW=false
# Requires M73 OGE_VAULT_CURRENT_RESOURCE_BACKUP_PREVIEW,
# OGE_VAULT_BACKUP_EXPORT_PREVIEW, OGE_VAULT_STANDALONE_PREVIEW,
# OGE_VAULT_MAIN_PREVIEW, OGE_VAULT_NOTE_API_PREVIEW,
# OGE_VAULT_HYBRID_DRAFT_PREVIEW all true, dedicated staging GitHub App,
# full checkVaultStagingReadiness, exact OGE_STAGING_URL=AUTH_URL and
# MONGODB_DB=oge_vault_restore_staging_<disposable>.
# POST /api/vault/backup-current-resources/plan is owner-only read-only.
# Returned counts and 18 UUID preview grant NO import/restore authorization.
# docs/OGE_VAULT_CURRENT_RESOURCE_RESTORE_PLAN_E6.md

# E7/M75 standalone Quick Notes OR AirNotes RESTORE (1-12 CREATE-ONLY records).
# DANGEROUS: Never enable on production, a personal GitHub Vault, or user data.
# Requires a separate signed-owner read-only selection intent and explicit
# owner-review of the source archive and target HEAD. DEFAULT OFF.
OGE_VAULT_STANDALONE_RESTORE_INTENT_PREVIEW=false
OGE_VAULT_STANDALONE_RESTORE_COMMIT_PREVIEW=false
OGE_VAULT_STANDALONE_RESTORE_WRITE_ACK=NO
# For explicit disposable staging operator test ONLY, also enable all
# M70/M71/M73/M74 staging flags including the encrypted draft preview,
# sign-in to an isolated https:// OGE_STAGING_URL exactly matching AUTH_URL
# and OGE_VAULT_BASE_URL origin with protected same-origin request Origin,
# and configure MONGODB_DB=oge_vault_restore_staging_<disposable>.
# After independent review the special ACK can be set to:
# OGE_VAULT_STANDALONE_RESTORE_WRITE_ACK=YES_DISPOSABLE_SIGNED_STAGING_ONLY
# Any unknown GitHub write outcome retains the existing durable
# vaultImportLock until separately authorized operator reconciliation.
# PRIVATE archive Note content must NEVER be committed to the app repository.
# docs/OGE_VAULT_STANDALONE_CREATE_ONLY_RESTORE_E7.md

# E8/M76 signed ONE-TIME Quick Notes/AirNotes restoration receipt (DEFAULT OFF).
# On protected disposable staging ONLY; no production settings.
OGE_VAULT_STANDALONE_RESTORE_APPROVAL_PREVIEW=false
# REQUIRED only for explicit isolated staging approval tests: generate
# 32 bytes of cryptographically secure entropy encoded as 64 hex chars,
# supplied ONLY in the staging secret manager, NEVER committed into Git:
# OGE_VAULT_STANDALONE_RESTORE_APPROVAL_KEY=<64 hex characters>
# The /authorize endpoint issues a HMAC-SHA256 signed owner/repo/session,
# one-kind, 1-12 selected UUID, archive fingerprint and target HEAD
# receipt valid for 10 minutes; no GitHub writer used by /authorize.
# /commit now additionally REQUIRES an atomic one-time claimed ticket
# under the M75 owner import fence, on top of the M75 default-OFF
# OGE_VAULT_STANDALONE_RESTORE_COMMIT_PREVIEW and special WRITE_ACK.
# Claim state persists without automatic retry; uncertain GitHub writes
# retain the existing vaultImportLock until independent operator review.
# MongoDB stores only vault_standalone_restore_approvals metadata/digests,
# never source note content, raw ticket, secret or GitHub credentials.
# docs/OGE_VAULT_STANDALONE_ONE_TIME_APPROVAL_E8.md

# E9/M77 read-only standalone uncertain restore incident inspection.
# DEFAULT OFF, independent of M75 writer and M76 receipt issuance flags.
OGE_VAULT_STANDALONE_RESTORE_RECONCILE_PREVIEW=false
# Requires M75/M74/M73 protected staging READ prerequisites and
# checkVaultStagingReadiness, same-origin HTTPS exact
# OGE_STAGING_URL=AUTH_URL, OGE_VAULT_BASE_URL origin and Origin header,
# and MONGODB_DB=oge_vault_restore_staging_<disposable>.
# Owner must provide the approved untrusted full M73 archive, exact M75
# selected kind/UUIDs/expected target HEAD/fingerprint, and an independently
# authorized exact durable owner vaultImportLock.operationId.
# Uses signed private contents:read GitHub App and claimed/confirmed M76
# receipt hashes, reads at most 20 linear commits and bounded Git trees,
# never writes GitHub content/drafts, never releases a lock or replays PATCH.
# Only operator-reviewed separate recovery procedures may clear quarantine.
# docs/OGE_VAULT_STANDALONE_RESTORE_RECONCILE_E9.md

# E10/M78 separate read-only quarantine recovery review packet (DEFAULT OFF)
OGE_VAULT_STANDALONE_QUARANTINE_REVIEW_PREVIEW=false
# Requires the M77 read-only reconcile staging preview, the M73/M74/M75
# isolated disposable signed staging prerequisites, matching HTTPS
# OGE_STAGING_URL=AUTH_URL, OGE_VAULT_BASE_URL origin and request Origin.
# Request exact approved M73 backup + M75 selected kind/UUIDs/source digest,
# exact vaultImportLock.operationId and an independently reviewed incident UUID.
# This only returns redacted owner lock, claimed receipt, read-only Git proof
# and bounded active-writer/draft/claimed-receipt indicators. Every outcome
# is HOLD. It cannot issue a lock-release token or mutate GitHub/Mongo notes.
# docs/OGE_VAULT_STANDALONE_QUARANTINE_REVIEW_E10.md

# E11/M79 offline TWO-REVIEWER signed quarantine dossier (DEFAULT OFF).
# No HTTP endpoint, GitHub write, MongoDB mutation or lock-release operation.
OGE_VAULT_QUARANTINE_SIGNATURE_REVIEW=NO
# The following are provided ONLY via a private isolated operator environment,
# never committed to this file, shell command histories, shared CI or logs.
# OGE_VAULT_QUARANTINE_DOSSIER_FILE=<absolute owner-private JSON>
# OGE_VAULT_QUARANTINE_M78_REVIEW_FILE=<absolute owner-private M78 JSON>
# OGE_VAULT_QUARANTINE_EXPECTED_INCIDENT_ID=<independently known UUID>
# OGE_VAULT_QUARANTINE_EXPECTED_OPERATION_ID=<independently known UUID>
# OGE_VAULT_QUARANTINE_EXPECTED_OWNER_SCOPE_SHA256=<sha256>
# OGE_VAULT_QUARANTINE_EXPECTED_REPO_ID=<verified private repo numeric ID>
# OGE_VAULT_QUARANTINE_EXPECTED_INSTALLATION_ID=<verified GitHub App installation ID>
# OGE_VAULT_QUARANTINE_OPERATOR_PUBLIC_KEY_DER_BASE64=<trusted SPKI DER Ed25519 public key>
# OGE_VAULT_QUARANTINE_REVIEWER_PUBLIC_KEY_DER_BASE64=<DIFFERENT SPKI DER Ed25519 public key>
# Operator-issued explicit opt-in ONLY for offline private disposable staging:
# OGE_VAULT_QUARANTINE_SIGNATURE_REVIEW=YES_OFFLINE_SIGNED_TWO_REVIEWERS_ONLY
# npm run vault:quarantine:verify-two-reviewers
# A valid 2-signature response exits 2: QUARANTINE HOLD, NEVER authorize unlock.
# The three external artifact hashes are unverified declared references,
# NOT evidence that GitHub workers have stopped or old writes are settled.
# docs/OGE_VAULT_QUARANTINE_TWO_REVIEWER_ATTESTATIONS_E11.md

# E12/M80 offline raw bytes SHA256 verification of three M79 signed
# private redacted evidence files. DEFAULT OFF, no HTTP, no GitHub/Mongo writer.
OGE_VAULT_QUARANTINE_ARTIFACT_HASH_REVIEW=NO
# Set only for independently signed metadata claims and private exact files:
# OGE_VAULT_QUARANTINE_ARTIFACT_HASH_REVIEW=YES_OFFLINE_PRIVATE_SIGNED_THREE_ARTIFACTS_ONLY
# OGE_VAULT_QUARANTINE_EVIDENCE_DIRECTORY=<absolute owner-private directory>
# Directory MUST contain exactly these three owner-only non-symlink files:
# writer-shutdown.redacted.txt (M79 writerShutdownSha256)
# outstanding-github-requests.redacted.txt (M79 outstandingGitHubRequestsSha256)
# encrypted-draft-preservation.redacted.txt (M79 encryptedDraftPreservationSha256)
# Requires ALL M79 offline protected context, trusted distinct public keys,
# exact independently scoped incident, and M79 signature opt-in.
# npm run vault:quarantine:verify-artifact-hashes
# SUCCESSFUL local bit-integrity comparison deliberately exits 2 (HOLD).
# Does NOT prove external source truth, worker quiescence, or allow unlock.
# docs/OGE_VAULT_QUARANTINE_SIGNED_ARTIFACT_INTEGRITY_E12.md

# E13/M81 signed producer claim binding to M79/M80 actual private bytes.
# DEFAULT OFF. Local-only, never a GitHub or MongoDB write/recovery grant.
OGE_VAULT_QUARANTINE_PRODUCER_REVIEW=NO
# Only in independent protected disposable operator runner:
# OGE_VAULT_QUARANTINE_PRODUCER_REVIEW=YES_OFFLINE_THREE_DISTINCT_SIGNED_PRODUCERS_ONLY
# OGE_VAULT_QUARANTINE_PRODUCER_MANIFEST_FILE=<private absolute JSON file>
# OGE_VAULT_QUARANTINE_WORKER_PRODUCER_PUBLIC_KEY_DER_BASE64=<trusted Ed25519 SPKI DER key>
# OGE_VAULT_QUARANTINE_GITHUB_REQUESTS_PRODUCER_PUBLIC_KEY_DER_BASE64=<different trusted Ed25519 SPKI DER key>
# OGE_VAULT_QUARANTINE_DRAFTS_PRODUCER_PUBLIC_KEY_DER_BASE64=<third trusted Ed25519 SPKI DER key>
# ALL THREE producer public keys must differ from EACH OTHER and from BOTH
# M79 trusted operator/reviewer public keys, and be vetted outside this program.
# Requires all existing M79/M80 signed reviewer and actual evidence hash gates.
# npm run vault:quarantine:verify-producer-provenance
# Verified 5-key signed evidence SHA agreement STILL exits 2 (HOLD).
# Does not prove real producer identity, telemetry truth, or writer quiescence.
# docs/OGE_VAULT_QUARANTINE_PRODUCER_ATTESTATIONS_E13.md

# E14 / M82 actual signed-in browser owner-private GitHub READ observation.
# DEFAULT OFF. Does NOT prove 2 physical devices or completed OAuth drill.
OGE_VAULT_SIGNED_DEVICE_ACCEPTANCE_READ_PREVIEW=false
# Enable only for independently approved isolated disposable HTTPS staging
# with exact OGE_STAGING_URL=AUTH_URL and OGE_VAULT_BASE_URL origin,
# checkVaultStagingReadiness passing and dedicated NON-production OAuth/App
# creds. MONGODB_DB=oge_vault_restore_staging_<disposable>.
# Main, note API and hybrid-draft flags must be preview enabled.
# Standalone restore commit/write ACK and ALL destructive flags MUST be OFF.
# POST /api/vault/acceptance/signed-device-read accepts 32 random bytes
# as 64 lowercase hex challenge and operator-DECLARED device-a/device-b label.
# Uses CURRENT Auth.js session and TWO contents:read GitHub App clients from
# SAME owner, verifies private Git head/commit tree and rechecks owner.
# No data modification, raw token/owner/commit SHA exposure, or unlock.
# Must be separately invoked from TWO real physical signed-in devices before
# any independent external OAuth/App staging acceptance can be reviewed.
# docs/OGE_VAULT_SIGNED_TWO_DEVICE_ACCEPTANCE_E14.md

# E15/M83 offline pair of TWO M82 signed-browser observations + the exact
# M67/M68 12-scenario evidence matrix and raw private on-disk SHA-256.
# DEFAULT OFF, no credentials/Notes/GitHub/Mongo API, no production grant.
OGE_VAULT_SIGNED_ACCEPTANCE_PAIR_REVIEW=NO
# Separately opt in only for a disposable operator-controlled staging run:
# OGE_VAULT_SIGNED_ACCEPTANCE_PAIR_REVIEW=YES_OFFLINE_TWO_SIGNED_DEVICE_OBSERVATIONS_AND_MATRIX_ONLY
# OGE_VAULT_TWO_DEVICE_EVIDENCE_HASH_REVIEW=YES_PRIVATE_REDACTED_ARTIFACTS_READ_ONLY
# OGE_VAULT_SIGNED_ACCEPTANCE_PAIR_FILE=<absolute owner-private pair JSON>
# OGE_VAULT_SIGNED_ACCEPTANCE_EXPECTED_RUN_ID=<independently known M67 UUID>
# OGE_VAULT_SIGNED_ACCEPTANCE_DEVICE_A_CHALLENGE_HEX=<independently retained private A 64-hex>
# OGE_VAULT_SIGNED_ACCEPTANCE_DEVICE_B_CHALLENGE_HEX=<different independently retained private B 64-hex>
# Requires existing M67 file and M68 private artifacts directory flags;
# staging HTTPS origin and isolated DB, all write/cutover/delete flags OFF.
# npm run vault:staging:review-signed-device-pair
# All 12-case local hashes matching => exit 2 (HOLD, external review needed).
# Missing/failed scenario => exit 3 (HOLD); invalid file/nonce => exit 1.
# DOES NOT PROVE physically distinct devices, genuine OAuth or GitHub 403/429,
# or permit a restore/import lock release/production deployment.
# docs/OGE_VAULT_SIGNED_TWO_DEVICE_ACCEPTANCE_PAIR_E15.md

# E16 / M84 real staging signed-session READ-only operator drill.
# DEFAULT OFF: no provider OAuth logins, Notes writes, remote fault injection.
OGE_VAULT_LIVE_ACCEPTANCE_READ_DRILL=NO
# Explicit opt-in only in dedicated disposable HTTPS staging:
# OGE_VAULT_LIVE_ACCEPTANCE_READ_DRILL=YES_TWO_PRIVATE_STAGING_SESSIONS_READ_ONLY
# OGE_VAULT_SIGNED_DEVICE_ACCEPTANCE_READ_PREVIEW=true
# OGE_STAGING_URL=AUTH_URL=OGE_VAULT_BASE_URL=https://<staging-origin>
# MONGODB_DB=oge_vault_restore_staging_<disposable>
# OGE_VAULT_SIGNED_ACCEPTANCE_EXPECTED_RUN_ID=<independent M67 run UUID>
# OGE_VAULT_M84_DEVICE_A_STORAGE_STATE=<owner-only 0600 staging Playwright JSON>
# OGE_VAULT_M84_DEVICE_B_STORAGE_STATE=<different owner-only staging JSON>
# OGE_VAULT_M84_OBSERVATION_OUTPUT_DIR=<precreated owner-only 0700 dir>
# OGE_VAULT_M84_CHALLENGE_OUTPUT_DIR=<DIFFERENT precreated owner-only 0700 dir>
# BOTH browser state files contain bearer credentials: NEVER commit, log, share,
# upload to ChatGPT, put in CI, or reuse production sessions.
# All standalone restore WRITE ACK/commit, cutover and delete flags remain OFF.
# npm run vault:staging:run-signed-read-drill
# Outputs m84-observations.json (M83 pair), private m84-challenges.json.
# Exit 2 means successful read-only probe, STILL requires human acceptance;
# exit 1 means blocked. It CANNOT verify real distinct physical devices.
# docs/OGE_VAULT_LIVE_SIGNED_STAGING_READ_DRILL_E16.md
