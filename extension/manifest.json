{
  "manifest_version": 3,
  "name": "OgeNotes — Study Toolbelt",
  "version": "0.1.0",
  "description": "Save tabs and quickly copy or visit your profile's social and portfolio links.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "OgeNotes Study Toolbelt",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost:3000/*"
  ]
}
